# EmailJS (https://dashboard.emailjs.com) — used by Emergency SOS to email contacts.
# The template's "To Email" must be {{to_email}}; use {{subject}}, {{message}}, {{to_name}}, {{from_name}} in its content.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API base URL (must be HTTPS in production, e.g. https://your-backend.onrender.com/api/v1)
VITE_API_URL=
